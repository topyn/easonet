# Hostname this server answers as — must match its DNS A record AND the VPS reverse DNS (PTR).
MX_HOSTNAME=mx1.easonet.com

# easonet app (production). The MX server calls /api/mail/address-list, /upload-url, /ingest.
EASONET_URL=https://www.easonet.com

# Shared with the easonet Vercel project (same name there). Generate: openssl rand -hex 32
MAIL_HMAC_SECRET=

# STARTTLS certificate (Let's Encrypt via certbot on the host, copied to /opt/easonet-mx/tls by
# deploy/certbot-deploy-hook.sh and mounted at /tls)
TLS_KEY_PATH=/tls/privkey.pem
TLS_CERT_PATH=/tls/fullchain.pem

# Optional
# RSPAMD_URL=http://rspamd:11333
# MAX_MESSAGE_BYTES=26214400
# CONN_PER_MIN_PER_IP=30
