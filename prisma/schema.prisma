generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                String     @id @default(cuid())
  supabaseId        String     @unique
  email             String     @unique
  stripeCustomerId  String?
  stripeSubId       String?
  plan              String     @default("trial")  // trial | starter | growth | pro
  trialEndsAt       DateTime?
  createdAt         DateTime   @default(now())
  identities        Identity[]
  threads           Thread[]
  waitlists         Waitlist[]
  stores            Store[]
  brandPages        BrandPage[]
  blockedSenders    BlockedSender[]
  mailDomains       MailDomain[]
}

model Identity {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  name         String
  email        String    @unique
  domain       String
  color        String    @default("#534AB7")
  signature    String?   @db.Text
  // Seller-domain mail (docs/specs/seller-domain-email-spec-2026-10-31.md in the ozstorehouse
  // repo): active | retiring (renamed, still receives until retiresAt) | system (postmaster/abuse)
  status       String    @default("active")
  retiresAt    DateTime?
  dnsVerified  Boolean   @default(false)
  smtpHost     String
  smtpPort     Int       @default(587)
  smtpUser     String
  smtpPass     String
  createdAt    DateTime  @default(now())
  threads      Thread[]
  sentMessages Message[] @relation("SentMessages")
  waitlists    Waitlist[]
  stores       Store[]
  brandPages   BrandPage[]
}

model Thread {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  subject      String
  identityId   String
  identity     Identity  @relation(fields: [identityId], references: [id])
  participants String[]
  read         Boolean   @default(false)
  status       String    @default("open") // open | archived
  lastAt       DateTime  @default(now())
  createdAt    DateTime  @default(now())
  messages     Message[]
}

model Message {
  id               String    @id @default(cuid())
  threadId         String
  thread           Thread    @relation(fields: [threadId], references: [id])
  direction        String    // "inbound" | "outbound"
  fromAddress      String
  toAddress        String
  ccAddress        String?
  bccAddress       String?
  subject          String
  bodyText         String    @db.Text
  bodyHtml         String?   @db.Text
  rawMessageId     String?
  sentByIdentityId String?
  sentByIdentity   Identity? @relation("SentMessages", fields: [sentByIdentityId], references: [id])
  createdAt        DateTime  @default(now())
  attachments      Attachment[]
}

model Attachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id])
  filename    String
  mimeType    String
  size        Int
  storagePath String
  createdAt   DateTime @default(now())
}

// A sender address a user has marked as spam — inbound mail from this address is
// auto-routed to the spam folder instead of the inbox (see pages/api/inbound/receive.ts).
model BlockedSender {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  address   String   // lowercased email address
  createdAt DateTime @default(now())

  @@unique([userId, address])
}

model Waitlist {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  identityId   String?
  identity     Identity?        @relation(fields: [identityId], references: [id])
  name         String
  slug         String           @unique
  headline     String           @default("Get early access")
  description  String?
  buttonText   String           @default("Join waitlist")
  thankYouMsg  String           @default("You're on the list! We'll be in touch.")
  showCount    Boolean          @default(true)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  signups      WaitlistSignup[]
  brandPages   BrandPage[]
}

model WaitlistSignup {
  id         String   @id @default(cuid())
  waitlistId String
  waitlist   Waitlist @relation(fields: [waitlistId], references: [id])
  email      String
  name       String?
  createdAt  DateTime @default(now())

  @@unique([waitlistId, email])
}

model Store {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  identityId  String?
  identity    Identity? @relation(fields: [identityId], references: [id])
  name        String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
  orders      Order[]
  brandPages  BrandPage[]
}

model Product {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  name         String
  description  String?
  price        Float
  currency     String   @default("USD")
  type         String   @default("digital") // digital | physical
  imageUrl     String?
  fileUrl      String?
  deliveryNote String?
  stock        Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Order {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  buyerEmail    String
  buyerName     String
  buyerAddress  String?
  quantity      Int      @default(1)
  total         Float
  currency      String   @default("USD")
  status        String   @default("pending") // pending | paid | fulfilled | cancelled
  paypalOrderId String?
  createdAt     DateTime @default(now())
}

model BrandPage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  identityId    String?
  identity      Identity? @relation(fields: [identityId], references: [id])
  storeId       String?
  store         Store?   @relation(fields: [storeId], references: [id])
  waitlistId    String?
  waitlist      Waitlist? @relation(fields: [waitlistId], references: [id])
  slug          String   @unique
  title         String
  tagline       String?
  description   String?
  logoUrl       String?
  accentColor   String   @default("#7B6EF6")
  bgStyle       String   @default("dark")
  fontStyle     String   @default("modern")
  customDomain  String?  @unique
  links         Json     @default("[]")
  sections      Json     @default("[]")
  template      String   @default("1")
  heroImage     String?
  headlineLine1 String?
  headlineLine2 String?
  badgeText     String?
  ctaText       String?
  featuresHeadline String?
  features      Json     @default("[]")
  stats         Json     @default("[]")
  aboutHeadline String?
  contactHeadline String?
  contactSub    String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// A seller domain whose mail we host on our own MX servers (mx1/mx2.easonet.com). Identities on
// this domain are the seller's chosen addresses; the MX servers pull the list via
// /api/mail/address-list and reject anything else at RCPT time.
model MailDomain {
  id             String   @id @default(cuid())
  domain         String   @unique // lowercased, no trailing dot
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  ozAccountId    String?  // OzStorehouse seller this domain belongs to, when there is one
  dnsMode        String   @default("manual") // manual | vercel
  inboundEnabled Boolean  @default(false)    // MX servers accept mail for it
  mxVerified     Boolean  @default(false)
  catchAll       Boolean  @default(false)    // unknown local parts go to the first active address
  dailySendCap   Int      @default(100)
  sendingPaused  Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// One row per (raw message, envelope recipient) delivered by our MX servers, so a retried
// delivery never creates a second copy.
model InboundReceipt {
  id          String   @id @default(cuid())
  rawSha256   String
  envelopeTo  String
  storagePath String
  threadId    String?
  result      String   // stored | spam | rejected
  receivedAt  DateTime @default(now())

  @@unique([rawSha256, envelopeTo])
}
